{
  "permissions": {
    "allow": [
      "Bash(python -m pytest tests/ -q)",
      "Bash(python -m aula_cli check *)"
    ],
    "deny": [
      "Edit(/manifiestos/**)",
      "Edit(/.github/workflows/**)",
      "Edit(/labs/**/verificar.py)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python herramientas/hook_formato.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/precommit.py"
          }
        ]
      }
    ]
  }
}